# PostgreSQL Database Configuration (copy this file to .env and set your own values)
# Note: the database password is set when the Docker volume is first created.
# If you change these values later, run `docker compose down -v` to recreate the volume.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=insurance_dw
DB_USER=postgres
DB_PASSWORD=change_me_locally

# Schema Configuration
DB_SCHEMA_RAW=staging
DB_SCHEMA_CORE=core
DB_SCHEMA_MARTS=marts

# Pipeline Configuration
RAW_DATA_PATH=data/raw/insurance_claims.csv
PROCESSED_DATA_PATH=data/processed
